# Шаблон prod-переменных. Скопируйте в .env.prod и заполните значения.
# .env.prod НЕ коммитится в git.

# === Приложение ===
APP_ENV=prod
APP_DEBUG=0
APP_SECRET=                          # openssl rand -hex 32
APP_SHARE_DIR=var/share
APP_DOMAIN=your.domain.com           # домен сервера (nginx + Certbot)
DEFAULT_URI=https://your.domain.com

# === Certbot / Let's Encrypt ===
CERTBOT_EMAIL=admin@your.domain.com  # email для уведомлений об истечении сертификата

# === База данных ===
POSTGRES_USER=rns_telcom
POSTGRES_PASSWORD=                   # придумайте сильный пароль
POSTGRES_DB=rns_telcom
DATABASE_URL="postgresql://rns_telcom:POSTGRES_PASSWORD@rns-telcom-db:5432/rns_telcom?serverVersion=16&charset=utf8"

# === Symfony ===
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
MAILER_DSN=null://null

# === Docker ===
UID=1000
GID=1000
